# =============================================================================
# OPTIONAL — local TLS reverse proxy in front of the wechat-flow console.
#
# Only needed if you terminate TLS locally (instead of / in addition to the
# Cloudflare quick tunnel). The default deployment uses the tunnel alone.
#
# IRON RULE: proxy ONLY the console port (127.0.0.1:8787).
# NEVER add a location/server that forwards the Chrome CDP port(s) — exposing
# CDP gives remote control over the logged-in browser. See
# .trellis/spec/console/ops-deploy.md (I27/I34) and security.md §8.
# =============================================================================
server {
    listen 127.0.0.1:8443 ssl;
    server_name console.local;

    ssl_certificate     /etc/ssl/wechat-console/fullchain.pem;
    ssl_certificate_key /etc/ssl/wechat-console/privkey.pem;

    client_max_body_size 8m;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Server-Sent Events (/api/jobs/:id/stream, /api/chats/:id/stream)
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_set_header Connection "";
    }
}
