# =============================================================================
# wechat-flow console — runtime environment
# Install to:  /etc/default/wechat-console   (chmod 0600 recommended)
#   cp deploy/systemd/wechat-console.env.example /etc/default/wechat-console
#
# NEVER put plaintext secrets (master key, SMTP password, CF token) in this
# file. The master key lives in a 0600 file (CONSOLE_MASTER_KEY_FILE) and
# credentials live encrypted in the DB (see .trellis/spec/console/security.md).
# =============================================================================

# ---- HTTP listener (keep loopback; the tunnel/reverse proxy fronts it) -------
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=8787
#CONSOLE_DB=/root/wechat-flow/console/console.db
#CONSOLE_MASTER_KEY_FILE=/root/.wechat-console/master.key
#CONSOLE_SESSION_TTL_HOURS=168
# Do NOT set this in production (would allow non-Secure cookies over plain HTTP):
#CONSOLE_ALLOW_INSECURE_COOKIE=1

# ---- worker / scheduler ------------------------------------------------------
CONSOLE_MAX_CONCURRENCY=2
#CONSOLE_WORKER_POLL_MS=1500
#CONSOLE_WORKER_DRAIN_MS=20000
# Failure backoff for scheduled jobs (I32/D31). 0 = disabled each dimension.
# Cooldown grows with consecutive failures: min(base × 2^(n-1), max).
CONSOLE_JOB_MAX_ATTEMPTS=8
CONSOLE_JOB_RETRY_COOLDOWN_MIN=15
CONSOLE_JOB_RETRY_COOLDOWN_MAX_MIN=60

# ---- API rate limit (I29/D29) ------------------------------------------------
# 0 PER_MIN disables limiting. /health and static assets are always exempt.
CONSOLE_RATE_PER_MIN=600
CONSOLE_RATE_BURST=120
# Trust Cloudflare's CF-Connecting-IP for keying (only behind a real CF tunnel).
CONSOLE_TRUST_CF=0

# ---- Cloudflare tunnel (Mode A: supervised in-process) -----------------------
# Set to 0 to disable. Enabling starts cloudflared as a child process.
CONSOLE_TUNNEL=1
#CONSOLE_TUNNEL_BIN=/usr/local/bin/cloudflared
CONSOLE_TUNNEL_MODE=quick
CONSOLE_TUNNEL_URL=http://127.0.0.1:8787
#CONSOLE_TUNNEL_POLL_MS=5000
#CONSOLE_TUNNEL_DEBOUNCE_MS=30000
#CONSOLE_TUNNEL_GRACEFUL_MS=5000
#CONSOLE_TUNNEL_MAIL_MAX_ATTEMPTS=3
# Email the admin a copy of tunnel-address change notices (default on).
CONSOLE_TUNNEL_MAIL_ADMIN=1

# ---- pi agent subprocess -----------------------------------------------------
#CONSOLE_PI_BIN=pi
#CONSOLE_CHAT_MAX=4
#CONSOLE_CHAT_TTL_MS=1800000
